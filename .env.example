# MixHub 環境変数サンプル
# Vercel などのデプロイ先の Environment Variables に設定する。

# Supabase 接続情報（next.config.ts にも既定値を埋め込み済み。上書きしたい場合のみ設定）
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Amazon アソシエイト ID（アフィリエイト）。本番では必ず実際の ID に差し替える。
# 未設定時は 'mixhub-22'（プレースホルダ）が使われる。
AMAZON_ASSOC_TAG=mixhub-22
