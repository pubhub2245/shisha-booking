# MixHub 環境変数サンプル
# Vercel などのデプロイ先の Environment Variables に設定する。

# Supabase 接続情報（next.config.ts にも既定値を埋め込み済み。上書きしたい場合のみ設定）
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Amazon アソシエイト ID（アフィリエイト）。本番では必ず実際の ID に差し替える。
# 未設定時は 'mixhub-22'（プレースホルダ）が使われる。
AMAZON_ASSOC_TAG=mixhub-22

# サイトの絶対URL（OGP・QR・決済のリダイレクト先）。独自ドメイン設定時はそれに合わせる。
# NEXT_PUBLIC_SITE_URL=https://shisha-booking.vercel.app

# メール機能（確認メール・パスワード再設定）の有効化。
# SMTP＋独自ドメインを設定したら true にする。既定(false)はメール無し運用（Supabaseの Confirm email を OFF に）。
# NEXT_PUBLIC_EMAIL_ENABLED=false

# ---- 有料ノートの決済（Stripe）----
# 未設定なら決済機能は無効のまま（「準備中」表示）。設定すると解錠が Stripe Checkout になる。
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx           # /api/stripe/webhook のエンドポイント署名シークレット
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # Webhook が解錠(mix_unlocks)を付与するために必要（サーバー限定・絶対に公開しない）
